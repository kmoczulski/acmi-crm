# Copy to .env (same folder) and fill in. .env is never committed or shared.

# Gmail app password for each teammate's mailbox, by CRM username (upper-case).
# Make one at https://myaccount.google.com/apppasswords
ACMI_IMAP_PASSWORD_KELLEN=

# AI summaries on company and person pages, contract reading, email domain sorting (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Google sign-in and the Google Calendar / Gmail permissions (Google Cloud -> APIs & Services -> Credentials).
# Without GOOGLE_CLIENT_ID the hub uses username / password sign-in and Mail in the hub stays off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts everyone's stored Google tokens (crm/tokens.py). Required before Mail in the hub can be turned on. Keep a
# copy in the password manager: without it the stored tokens can't be read and everyone reconnects Google.
# Make one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACMI_TOKEN_KEY=

# Browser notifications (crm/push.py): python manage.py vapid_keys prints a pair. Changing them later means everyone
# turns notifications on again.
ACMI_VAPID_PUBLIC_KEY=
ACMI_VAPID_PRIVATE_KEY=
# ACMI_VAPID_SUBJECT=https://hub.acmigroup.com

# Google Drive, read-only, for the Drive files panels and the data room (docs/DATA_ROOM.md): the service account's
# JSON key on the laptop, or ACMI_DRIVE_ADC=true on Cloud Run. ACMI_DRIVE_TENANCY_FOLDER is the "3 Tenancy" folder ID.
# ACMI_DRIVE_SA_FILE=
# ACMI_DRIVE_ADC=false
# ACMI_DRIVE_TENANCY_FOLDER=
# On Cloud Run, Drive folders in place of the laptop's: the weekly news scans (blank = ACMI_NEWS_WATCH_FOLDER) and
# the daily Granola JSON files, which sync_all imports once each (blank = run import_meetings on the laptop).
# ACMI_NEWS_DRIVE_FOLDER=
# ACMI_GRANOLA_DRIVE_FOLDER=

# Switches: Mail in the hub for everyone (each person still turns their own on), and sending from the hub at all.
# ACMI_MAIL_CLIENT=true
# ACMI_MAIL_SEND=true

# Production only
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# ACMI_CRON_SECRET=
