# Copy to .env (same folder) and fill in. .env is never committed or shared.

# Gmail app password for each teammate's mailbox, by CRM username (upper-case).
# Make one at https://myaccount.google.com/apppasswords
ACMI_IMAP_PASSWORD_KELLEN=

# AI summaries on company and person pages (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Production only
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# ACMI_CRON_SECRET=
